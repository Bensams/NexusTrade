generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// RBAC - Role-Based Access Control
// ============================================

enum Role {
  SUPER_ADMIN  // Owner: can do everything including manage other admins
  ADMIN        // Can manage settings and support tickets
  MODERATOR    // Content policing: review listings, mute/ban users
  USER         // Default role for all users
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  bio             String?   // User bio/description
  balance         Float     @default(0)
  isSeller        Boolean   @default(false)
  role            Role      @default(USER)  // RBAC role for admin permissions
  isSupportAgent  Boolean   @default(false) // Can receive support chat requests
  bannedUntil     DateTime? // null = not banned, past = unbanned, future/9999 = banned
  fullName        String?   // Legal name for payouts
  payoutMethod    String?   // "gcash" | "maya"
  payoutNumber    String?   // Phone number for payouts
  sellerAgreedAt  DateTime? // When they agreed to 10% fee
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  orders        Order[]
  withdrawals   Withdrawal[]
  sentMessages  Message[] @relation("SentMessages")
  conversations ConversationParticipant[]
  reviewsGiven  Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  notifications Notification[]
  walletTransactions WalletTransaction[]
  cashInRequests CashInRequest[]
  auditLogs     AuditLog[]
  disputesOpened   Dispute[] @relation("DisputesOpened")
  disputesResolved Dispute[] @relation("DisputesResolved")
}


model WalletTransaction {
  id        String          @id @default(cuid())
  amount    Float           // Positive for credit, negative for debit
  type      TransactionType
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditId   String?         // Reference ID (Order ID, Withdrawal ID, etc)
  createdAt DateTime        @default(now())
}

model CashInRequest {
  id            String        @id @default(cuid())
  amount        Float
  status        RequestStatus @default(PENDING)
  proofUrl      String?
  paymentMethod String
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}


enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  SALE
  REFUND
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id          String      @id @default(cuid())
  title         String
  description   String
  price         Float
  originalPrice Float?      // Original price before any reduction
  type          ListingType
  game          String
  imageUrl      String?       // Legacy single image (for backward compatibility)
  images        String[]      // Array of image URLs (Cloudinary)
  sellerId      String
  isBanned      Boolean     @default(false)  // Admin can hide/takedown listings
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders      Order[]
  reviews     Review[]
  conversations Conversation[]
}

model Order {
  id             String      @id @default(cuid())
  status         OrderStatus @default(PENDING)
  buyerId        String
  listingId      String
  paymentMethod  String?     // "gcash" | "maya"
  paymentReceipt String?     // Screenshot URL
  paidAt         DateTime?
  approvedAt     DateTime?
  deliveryProof  String?     // Seller's delivery proof screenshot
  deliveredAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  review    Review?
  conversations Conversation[]
  dispute   Dispute?
}

model Conversation {
  id           String   @id @default(cuid())
  listingId    String?
  orderId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  participants ConversationParticipant[]
  messages     Message[]
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderId       String
  conversationId String
  createdAt      DateTime     @default(now())
  
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  reviewerId String
  sellerId   String
  orderId    String   @unique
  listingId  String
  createdAt  DateTime @default(now())
  
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

enum ListingType {
  ITEM
  SERVICE
}

enum OrderStatus {
  PENDING             // Order created, waiting for payment
  AWAITING_PAYMENT    // User selected payment method
  PAYMENT_SUBMITTED   // User uploaded receipt
  PAID                // Admin approved payment, awaiting delivery
  DELIVERY_SUBMITTED  // Seller uploaded delivery proof
  COMPLETED           // Admin verified delivery, buyer can review
  CANCELLED
  REFUNDED
  DISPUTED            // Order is under dispute - funds frozen
}

model Withdrawal {
  id            String           @id @default(cuid())
  amount        Float
  status        WithdrawalStatus @default(PENDING)
  payoutMethod  String           // "gcash" | "maya"
  payoutNumber  String
  payoutName    String
  processedAt   DateTime?
  processedBy   String?          // Admin who processed
  notes         String?          // Admin notes
  userId        String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WithdrawalStatus {
  PENDING     // Awaiting admin processing
  PROCESSING  // Admin is processing
  COMPLETED   // Payout sent
  REJECTED    // Rejected by admin
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // Recipient
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  orderId     String?          // Related order if applicable
  listingId   String?          // Related listing if applicable
  cashInRequestId String?      // Related cash-in request
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  // Buyer notifications
  PAYMENT_APPROVED      // Payment approved by admin
  PAYMENT_DECLINED      // Payment declined by admin
  ORDER_DELIVERED       // Seller delivered the item
  ORDER_COMPLETED       // Order marked complete
  
  // Seller notifications
  NEW_ORDER             // New order received
  PAYOUT_APPROVED       // Withdrawal approved
  PAYOUT_REJECTED       // Withdrawal rejected
  
  // Admin notifications
  PAYMENT_TO_REVIEW     // New payment submission
  DELIVERY_TO_REVIEW    // New delivery submission
  PAYOUT_REQUEST        // New withdrawal request
  CASHIN_TO_REVIEW      // New cash-in request

  // Additional types
  DELIVERY_APPROVED     // Delivery proof approved (Seller notification)
  DELIVERY_REJECTED     // Delivery proof rejected (Seller notification)
  ORDER_REFUNDED        // Order refund processed (Buyer/Seller notification)
  CASHIN_APPROVED       // Cash-in approved
  CASHIN_REJECTED       // Cash-in rejected

  // System notifications
  SYSTEM                // General system notification
  FEE_UPDATED           // Platform fee has been updated

  // Dispute notifications
  DISPUTE_OPENED        // Seller receives when buyer opens dispute
  DISPUTE_RESOLVED      // Both parties receive when admin resolves
  DISPUTE_UPDATE        // Status update notifications

  // Transaction flow notifications
  SALE_COMPLETED        // Seller receives when buyer confirms delivery
  REVIEW_REMINDER       // Buyer receives prompt to leave review
}

// ============================================
// ADMIN CMS MODELS
// ============================================

// Singleton settings table - only one row exists
model SystemSettings {
  id                     String   @id @default("default")
  transactionFeePercent  Float    @default(5.0)  // Platform fee percentage (0-100)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Site settings for social links and contact info (singleton)
model SiteSettings {
  id            String   @id @default("default")
  discordLink   String?  // Discord server invite link
  twitterLink   String?  // Twitter/X profile link
  instagramLink String?  // Instagram profile link
  supportEmail  String?  // Support email address
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Supported games on the marketplace
model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique  // URL-friendly name
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Item types/categories for listings
model ItemType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// AUDIT LOG SYSTEM
// ============================================

enum ActionType {
  USER_LOGIN
  USER_LOGOUT
  ORDER_CREATED
  ORDER_COMPLETED
  LISTING_CREATED
  LISTING_UPDATED
  LISTING_DELETED
  CHAT_INITIATED
  WITHDRAWAL_REQUESTED
  CASHIN_REQUESTED
  PAYMENT_SUBMITTED
  ADMIN_ACTION
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

model AuditLog {
  id           String     @id @default(cuid())
  userId       String
  actionType   ActionType
  resourceId   String?    // Order ID, Listing ID, Chat ID, etc.
  resourceType String?    // "order", "listing", "conversation", etc.
  metadata     String?    // JSON string for additional context (no sensitive data)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([actionType])
}

// ============================================
// SITE ANALYTICS
// ============================================

model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String   // UUID from cookie
  date      DateTime @db.Date  // Just the date (no time) for daily tracking
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([visitorId, date])  // One entry per visitor per day
  @@index([date])
}

// ============================================
// BAN SYSTEM
// ============================================

model BlacklistedIdentifier {
  id          String    @id @default(cuid())
  type        String    // "IP" | "DEVICE_FINGERPRINT" | "USER_AGENT"
  value       String    // The actual IP address or fingerprint hash
  userId      String    // The banned user this came from
  reason      String?   // Optional admin notes
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // null = permanent, matches user's bannedUntil

  @@index([type, value])  // Fast lookup during auth
  @@index([userId])
}

// ============================================
// DISPUTE RESOLUTION SYSTEM
// ============================================

enum DisputeStatus {
  OPEN          // Dispute filed, awaiting admin review
  UNDER_REVIEW  // Admin is actively investigating
  RESOLVED      // Resolution applied
  CLOSED        // Dispute closed without action
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  SELLER_UNRESPONSIVE
  FRAUD_SUSPECTED
  OTHER
}

enum DisputeResolution {
  REFUND_BUYER
  RELEASE_TO_SELLER
  PARTIAL_REFUND
  NO_ACTION
}

model Dispute {
  id             String            @id @default(cuid())
  orderId        String            @unique  // One active dispute per order
  openedById     String            // User who opened the dispute
  reason         DisputeReason
  description    String            // Buyer's explanation
  status         DisputeStatus     @default(OPEN)
  resolution     DisputeResolution?
  resolvedById   String?           // Admin who resolved
  resolvedAt     DateTime?
  adminNotes     String?           // Internal notes
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy       User              @relation("DisputesOpened", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy     User?             @relation("DisputesResolved", fields: [resolvedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}
